# ==============================================================================
# M5 v2 Context Engine - Environment Configuration
# ==============================================================================

# Directory or codebase to index on startup (defaults to current directory)
WORKSPACE_ROOT=.

# Vector Database (Qdrant)
# If empty or not running, M5 falls back to high-speed in-memory vector storage automatically.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
