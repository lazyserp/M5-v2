# ==============================================================================
# M5 v2 — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to Git.
# ==============================================================================

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Admin key — the master password for creating API keys and accessing admin routes.
# Generate a strong random value:
#   python -c "import secrets; print('m5_admin_' + secrets.token_hex(24))"
M5_ADMIN_KEY=change_me_generate_a_real_random_key

# ── INDEXING ──────────────────────────────────────────────────────────────────

# The local directory M5 will index on startup.
# Leave as "." to index the current working directory.
# Use an absolute path to index a specific repository:
#   Windows: D:\myproject\backend
#   macOS/Linux: /home/you/myproject/backend
WORKSPACE_ROOT=.

# Default tenant namespace for the auto-indexed workspace.
# These become part of the collection name in Qdrant.
DEFAULT_ORG_ID=default_org
DEFAULT_DEPT_ID=default_dept
DEFAULT_REPO_ID=default_repo

# ── VECTOR DATABASE (Qdrant) ──────────────────────────────────────────────────

# If Qdrant is running locally (via Docker):
#   docker run -p 6333:6333 qdrant/qdrant
# If empty or Qdrant is unreachable, M5 falls back to in-memory vector storage.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call M5 from a browser.
# Default (empty) = localhost only. Add your dashboard URL for production:
#   M5_CORS_ORIGINS=https://app.yourdomain.com
M5_CORS_ORIGINS=

# ── WEBHOOK SECURITY ─────────────────────────────────────────────────────────

# HMAC secret for GitHub push webhook signature verification.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must match the "Secret" field in your GitHub Webhook settings.
# If not set, ALL webhook calls are REJECTED (fail-closed).
GITHUB_WEBHOOK_SECRET=

# Set to "true" ONLY in local development to skip webhook signature checking.
# NEVER set to true in production.
M5_ALLOW_UNSIGNED_WEBHOOKS=false

# ── BM25 CACHE ───────────────────────────────────────────────────────────────

# Where to store BM25 keyword-search snapshots (default = OS app-data folder).
# Leave empty unless you want a custom location.
# Windows default: %LOCALAPPDATA%\M5\bm25
# macOS/Linux default: ~/.local/share/m5/bm25
M5_BM25_CACHE_DIR=

# ── EXPERIMENTAL (disabled by default) ───────────────────────────────────────

# Enable M5's own LLM agent loop. NEVER enable in production.
M5_ENABLE_DEV_AGENT_MODE=false
